{
  "private": true,
  "description": "GitHub Action to configure s3cmd",
  "type": "module",
  "main": "lib/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint": "biome lint .",
    "package": "rollup -c",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": ["actions", "node", "setup"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.1.2",
    "js-yaml": "^4.1.1",
    "rollup": "^4.62.4",
    "typescript": "^5.9.3"
  }
}
