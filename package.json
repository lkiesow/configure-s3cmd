{
  "private": true,
  "description": "GitHub Action to configure s3cmd",
  "type": "module",
  "main": "lib/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint": "biome lint .",
    "package": "node esbuild.config.mjs",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": ["actions", "node", "setup"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
